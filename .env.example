# ---------------------------------------------------------------------------
# SFI Coverage Desk — deployment settings
# Copy to .env.local for local use, or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# Where the SQLite database lives. In Docker this must point at a mounted
# volume, otherwise every redeploy starts from an empty database.
DATABASE_PATH=/data/sfi.db

# The account that gets Super Admin on first sign-up. Locked to this address.
SUPER_ADMIN_EMAIL=shaps@sflinsider.com

# Public URL, used for links inside emails.
APP_URL=https://coverage.sflinsider.com

# --- Email (optional, but required for password resets to be usable) --------
# Without these, resets are logged to the server console instead of sent, and
# the reset link is never shown in the browser in production.
RESEND_API_KEY=
MAIL_FROM="SFI Coverage Desk <desk@sflinsider.com>"

# Set to "off" to disable decision emails org-wide. Individuals can also opt out
# from their own profile page.
MAIL_NOTIFICATIONS=on
